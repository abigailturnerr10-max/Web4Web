# Copy this file to .env and fill in real values.
# Nothing here is required for the app to run — every integration
# below degrades to a clearly-labeled placeholder until configured.

# Supabase (orders storage + server-side payment verification) — Project
# Settings > API. The anon key is safe to expose here: it's designed for
# frontend use alongside the Row Level Security rules in supabase/schema.sql.
# NEVER put the service_role key or your Flutterwave secret key in this file —
# those belong only in Supabase's Edge Function environment variables. See
# supabase/README.md for setup steps.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Flutterwave (Web4Web's own checkout — NGN and USD) — from your Flutterwave dashboard
VITE_FLW_PUBLIC_KEY=

# EmailJS (order notification email) — emailjs.com > Email Services / Templates
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
# Separate template for the client-facing order receipt — same service +
# public key as above, different template (order_summary/content_form_link/
# business_whatsapp/business_email variables).
VITE_EMAILJS_CLIENT_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
VITE_BUSINESS_EMAIL=orders@web4web.example

# WhatsApp deep link target — your business number, digits only, with country code
VITE_BUSINESS_WHATSAPP_NUMBER=
